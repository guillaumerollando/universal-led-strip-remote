<?xml version="1.0" encoding="utf-8"?>
<!-- Pièce allumée : un filet de lumière chaude sur le bas de la ligne, comme un ruban. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="90" android:startColor="#33FFB547" android:centerColor="#0DFFB547" android:endColor="#1D2029" />
      <corners android:radius="16dp" />
    </shape>
  </item>
  <item android:gravity="bottom" android:height="2dp" android:left="16dp" android:right="16dp" android:bottom="1dp">
    <shape android:shape="rectangle">
      <solid android:color="#FFB547" />
      <corners android:radius="1dp" />
    </shape>
  </item>
</layer-list>
