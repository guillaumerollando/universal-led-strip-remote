{
  "expo": {
    "name": "LED Strip Remote",
    "slug": "led-strip-remote",
    "scheme": "ledstrip",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F14",
    "locales": {
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "ru": "./locales/ru.json",
      "uk": "./locales/uk.json",
      "tr": "./locales/tr.json",
      "ar": "./locales/ar.json",
      "he": "./locales/he.json",
      "hi": "./locales/hi.json",
      "id": "./locales/id.json",
      "vi": "./locales/vi.json",
      "th": "./locales/th.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "sv": "./locales/sv.json",
      "cs": "./locales/cs.json",
      "ro": "./locales/ro.json",
      "hu": "./locales/hu.json",
      "el": "./locales/el.json"
    },
    "android": {
      "package": "com.rollandostudio.ledstripremote",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.TRANSMIT_IR"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A0B0F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0B0F"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Bluetooth (react-native-ble-plx, RxAndroidBle, RxJava) et UDP (react-native-udp) : modules natifs appelés depuis JS, gardés tels quels par prudence\n-keep class com.bleplx.** { *; }\n-keep class com.polidea.rxandroidble2.** { *; }\n-dontwarn com.polidea.rxandroidble2.**\n-keep class com.tradle.react.** { *; }\n# Worklets (Reanimated 4)\n-keep class com.swmansion.worklets.** { *; }"
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withLeanImages"
    ]
  }
}
